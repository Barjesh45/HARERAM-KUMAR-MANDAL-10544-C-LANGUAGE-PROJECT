//atm withdrawal simluation


#include <stdio.h>

int main() {
    int total_amount=50000,enter_amount,atm_pin=1234,entered_pin;
    printf("Enter 4-digit PIN number: ");
    scanf("%d",&entered_pin);
    
    if(atm_pin==entered_pin){
        printf("Enter Amount: ");
        scanf("%d",&enter_amount);
        if(enter_amount > total_amount){
            printf("Not sufficient amount\n");
        }else{
            //printf("enter the amount in mulptiple of 500");
            if(enter_amount % 500==0){
                int remaining = total_amount-enter_amount;
                printf("cash updating...\n");
                printf("Cash withdrawaled.\n");
                printf("Total balance = %d\n",remaining);
            }else{
                printf("enter the amount in multiple of 500.");
            }
        }
    }else{
        printf("wrong pin");
    }
    return 0;
}
